# =============================================================================
adapters/
# Keep only .gitkeep and config files
adapters/*.safetensors
adapters/*/*.safetensors

# MLX Model Cache (downloaded automatically)
.mlx_cache/
.mlxx/

# HuggingFace Cache
.cache/
.huggingface/

